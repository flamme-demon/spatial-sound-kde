# xgettext ne peut pas les extraire, ils sont donc listes a la main.
msgid "best overall compromise"
msgstr "le meilleur compromis"

msgid "very dry"
msgstr "très sec"

msgid "driest of all (44.1 kHz)"
msgstr "le plus sec (44,1 kHz)"

msgid "dry, less contrasted"
msgstr "sec, moins contrasté"

msgid "spacious, slightly distant"
msgstr "ample, un peu distant"

msgid "Sennheiser GSX, coloured"
